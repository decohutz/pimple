@baseUrl = http://localhost:8000
@imagePath = ./../../data/samples/sample.jpg
@imagePath2 = ./../../data/samples/sample2.jpg

###
# 1) Exemplo principal — igual ao do contrato
#    sex = male, localization = back, age = 29
#    imagem: {{imagePath}}
###
POST {{baseUrl}}/analyze
Content-Type: multipart/form-data; boundary=BOUND

--BOUND
Content-Disposition: form-data; name="sex"

male
--BOUND
Content-Disposition: form-data; name="localization"

back
--BOUND
Content-Disposition: form-data; name="age"

29
--BOUND
Content-Disposition: form-data; name="image"; filename="sample.jpg"
Content-Type: image/jpeg

< {{imagePath}}
--BOUND--


###
# 2) Exemplo alternativo — paciente mais velho, outra região
#    sex = female, localization = face, age = 54
#    imagem: {{imagePath2}}
#    (se ainda não existir sample2.jpg, copie a primeira imagem
#     e renomeie só pra ter dois casos diferentes)
###
POST {{baseUrl}}/analyze
Content-Type: multipart/form-data; boundary=BOUND2

--BOUND2
Content-Disposition: form-data; name="sex"

female
--BOUND2
Content-Disposition: form-data; name="localization"

face
--BOUND2
Content-Disposition: form-data; name="age"

54
--BOUND2
Content-Disposition: form-data; name="image"; filename="sample2.jpg"
Content-Type: image/jpeg

< {{imagePath2}}
--BOUND2--


###
# 3) Exemplo de erro — tipo de arquivo inválido (PDF)
#    Esperado: status 400 com mensagem de erro
###
POST {{baseUrl}}/analyze
Content-Type: multipart/form-data; boundary=BOUND_ERR

--BOUND_ERR
Content-Disposition: form-data; name="sex"

male
--BOUND_ERR
Content-Disposition: form-data; name="localization"

back
--BOUND_ERR
Content-Disposition: form-data; name="age"

40
--BOUND_ERR
Content-Disposition: form-data; name="image"; filename="arquivo.pdf"
Content-Type: application/pdf

< {{imagePath}}
--BOUND_ERR--
