{
  "architecture": "resnet50",
  "pretrained_weights": "IMAGENET1K_V2",
  "allow_pretrained_download": false,
  "image_size": 224,
  "batch_size": 128,
  "epochs": 18,
  "optimizer": "AdamW",
  "learning_rate": 0.0003,
  "weight_decay": 0.0001,
  "scheduler": "CosineAnnealingLR",
  "loss": "cross_entropy",
  "loss_reduction": "weighted_mean_true_class",
  "label_smoothing": 0.0,
  "class_weighting": "inverse_frequency_mean_one",
  "sampling": "shuffle",
  "augmentations": {
    "horizontal_flip_p": 0.5,
    "vertical_flip_p": 0.5,
    "rotation_degrees": 180,
    "brightness": 0.1,
    "contrast": 0.1,
    "saturation": 0.1,
    "hue": 0.02
  },
  "seed": 42,
  "early_stopping_patience": 3,
  "checkpoint_metric": "validation_macro_f1",
  "checkpoint_tie": "earliest_epoch",
  "nan_policy": "fail_run",
  "freeze_backbone_epochs": 0,
  "num_workers": 0,
  "device": "cuda",
  "amp": true,
  "deterministic": true,
  "tf32": false
}
